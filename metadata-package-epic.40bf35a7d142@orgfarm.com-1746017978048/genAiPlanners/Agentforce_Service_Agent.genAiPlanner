        <genAiPluginName>Enquire_Cases_and_Perform_actions</genAiPluginName>
    </genAiPlugins>
    <genAiPlugins>
        <genAiPluginName>Notify_Slack_Channel</genAiPluginName>
    </genAiPlugins>
    <genAiPlugins>
        <genAiPluginName>Slack__Slack</genAiPluginName>
    </genAiPlugins>
    <masterLabel>Agentforce Service Agent</masterLabel>
    <plannerType>AiCopilot__ReAct</plannerType>
</GenAiPlanner>
